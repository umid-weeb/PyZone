# Frontend
VITE_ARENA_API_BASE=http://127.0.0.1:8000

# Backend app
ARENA_APP_NAME=Pyzone Arena Backend
ARENA_API_PREFIX=/api
ARENA_FRONTEND_API_BASE=/api
ARENA_LOG_LEVEL=INFO
ARENA_CORS_ALLOW_ORIGINS=*
ARENA_JWT_SECRET=change-me-to-a-strong-random-secret
ARENA_JWT_EXPIRE_MINUTES=10080

# Problem source (public)
ARENA_GITHUB_OWNER=your-github-owner
ARENA_GITHUB_REPO=your-problem-repo
ARENA_GITHUB_BRANCH=main
ARENA_GITHUB_TOKEN=
ARENA_GITHUB_PROBLEM_ROOT=problems

# Hidden tests source (choose local root OR hidden GitHub repo)
ARENA_HIDDEN_TEST_ROOT=
ARENA_HIDDEN_GITHUB_OWNER=
ARENA_HIDDEN_GITHUB_REPO=
ARENA_HIDDEN_GITHUB_BRANCH=main
ARENA_HIDDEN_GITHUB_TOKEN=
ARENA_HIDDEN_GITHUB_PROBLEM_ROOT=problems

# Runtime
ARENA_REDIS_URL=redis://localhost:6379/0
ARENA_USE_INLINE_EXECUTION=true
ARENA_JUDGE_USE_DOCKER=false
ARENA_JUDGE_DOCKER_IMAGE=python:3.11-slim
ARENA_JUDGE_CPU_LIMIT=1
ARENA_JUDGE_PIDS_LIMIT=64
ARENA_CACHE_TTL_SECONDS=300

# Stripe service (optional)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Supabase (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ARENA_SUPABASE_AVATAR_BUCKET=avatars
